// Definicao de atalhos que simplifica e reaproveita o codigo

macro RolarFrente = [Baixo -> Frente]
macro RolarTras = [Baixo -> Tras]

// Definicao de Combos e Golpes (funcoes)

combo Voadora() {
    return Cima -> Frente -> Chute Alto
}

arena() {
    Guilhotina(2)
}

// Lista de Combos a partir de um ataque (Objetos ou listas)

combo "Iniciacao" = [RolarTras] -> {
    [Jab] -> "Hadouken",
    [SocoForte] -> "HadoukenForte"
}