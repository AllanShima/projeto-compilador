// exemplo.ko — O primeiro programa valido do Kombo Script.

macro RolarFrente = Baixo -> Frente;
macro Parado = Neutro;

combo Mashing = ChuteFraco+;
combo Ataque = Parado? -> Jab;
combo Hadouken = RolarFrente -> Jab;
combo HadoukenForte = RolarFrente -> SocoForte;

arena {
    on Mashing(m) => emit("Mashing");
    on Ataque(a) => emit("Ataque");
    on Hadouken(h) => emit("Hadouken");
    on HadoukenForte(f) => emit("HadoukenForte");
}